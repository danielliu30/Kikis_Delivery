# Copy this file to .env and fill in real values. Never commit .env to source control.

# PostgreSQL — defaults match docker-compose.yml
DATABASE_URL=jdbc:postgresql://localhost:5432/bakery
DATABASE_USER=bakery
DATABASE_PASSWORD=bakery

# Email (Gmail SMTP)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password   # Use a Gmail App Password, not your account password

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=replace-with-64-plus-byte-random-base64-string

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
